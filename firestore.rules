rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnerOf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isVendorOwner(vendorId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid;
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{uid} {
      // Anyone signed in can read profiles (for display names, ratings, etc.)
      allow read: if isSignedIn();
      // Users can only write their own profile; admins can write any
      allow create: if isAdmin() || request.auth.uid == uid;
      allow update: if isOwnerOf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Vendors ────────────────────────────────────────────
    match /vendors/{vendorId} {
      // Public read for browsing
      allow read: if true;
      // Only the vendor owner or admin can create/update/delete
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isOwnerOf(resource.data.ownerId) || isAdmin();
      allow delete: if isOwnerOf(resource.data.ownerId) || isAdmin();
    }

    // ── Products ───────────────────────────────────────────
    match /products/{productId} {
      // Public read for browsing
      allow read: if true;
      // Only the vendor owner (looked up from the product's vendorId) or admin
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid;
    }

    // ── Orders ─────────────────────────────────────────────
    match /orders/{orderId} {
      // Customer, assigned vendor, assigned driver, or admin can read
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.customerId ||
        isVendorOwner(resource.data.vendorId) ||
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );

      // Any signed-in user can create an order (customer placing order)
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

      // Status updates: customer (cancel), vendor (accept/prepare), driver (pickedUp/inTransit/delivered), admin (any)
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.customerId ||
        isVendorOwner(resource.data.vendorId) ||
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Drivers ────────────────────────────────────────────
    match /drivers/{driverId} {
      // Public read for matching/assignment
      allow read: if true;
      // Driver can create their own profile; admin can create any
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Driver can update own profile; admin can update any
      allow update: if isOwnerOf(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Categories ─────────────────────────────────────────
    match /categories/{categoryId} {
      // Public read for browsing
      allow read: if true;
      // Only admin can manage categories
      allow write: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      // Cloud Functions (admin SDK) writes these; clients mark as read
      allow create: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
