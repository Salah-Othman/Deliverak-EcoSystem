rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnerOf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // NOTE: get() on a missing doc causes rule denial (safe default).
    // This protects against orphaned references (deleted vendor → products locked).

    function isVendorOwner(vendorId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid;
    }

    function isValidRole(role) {
      return role in ['customer', 'driver', 'vendor', 'admin'];
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();

      // New users can only self-register as customer with required fields
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasAll(['name', 'phone', 'role', 'createdAt'])
        && isValidRole(request.resource.data.role);

      // Admins can update anything; owners cannot change their own role
      allow update: if (isAdmin())
        || (isOwnerOf(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      allow delete: if isAdmin();
    }

    // ── Vendors ────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if true;

      // New vendors must be created closed, with required fields
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.keys().hasAll(['name', 'category', 'ownerId', 'isOpen', 'location', 'address', 'createdAt'])
        && request.resource.data.isOpen == false;

      // Owners can update limited fields; admins can update anything
      allow update: if (isAdmin())
        || (isOwnerOf(resource.data.ownerId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isOpen', 'name', 'description', 'image', 'address', 'location']));

      allow delete: if isAdmin();
    }

    // ── Products ───────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;

      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['vendorId', 'name', 'price', 'isAvailable', 'createdAt'])
        && request.resource.data.price > 0;

      // Vendors can update limited fields on their products; admins can update anything
      allow update: if (isAdmin())
        || (isSignedIn()
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'description', 'price', 'discountPrice', 'images', 'category', 'isAvailable']));

      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid;
    }

    // ── Orders ─────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.customerId ||
        isVendorOwner(resource.data.vendorId) ||
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );

      // Customer places order — validate required fields and sane defaults
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.customerId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
             'customerId', 'vendorId', 'items', 'totalAmount',
             'deliveryFee', 'status', 'deliveryAddress', 'paymentMethod', 'createdAt'
           ])
        && request.resource.data.totalAmount > 0
        && request.resource.data.items.size() > 0;

      // Status-only updates: restrict which fields each role can change
      allow update: if isSignedIn() && (
        // Customer can only cancel their own order
        (request.auth.uid == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled')
        ||
        // Vendor can update status only
        (isVendorOwner(resource.data.vendorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['accepted', 'preparing'])
        ||
        // Driver can update status only
        (request.auth.uid == resource.data.driverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['picked_up', 'in_transit', 'delivered'])
        ||
        // Admin can update any field
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Drivers ────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'vehicleType', 'isOnline', 'createdAt'])
        && request.resource.data.isOnline == false;

      // Drivers can only update location and online status; admins can update anything
      allow update: if (isAdmin())
        || (isOwnerOf(resource.data.userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['currentLocation', 'isOnline', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ── Categories ─────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
