rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ── Profile images ─────────────────────────────────────
    // Users can upload/view their own profile images
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Vendor images ──────────────────────────────────────
    // Vendor owners can upload images for their vendor
    match /vendor_images/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
                   && get(/databases/(default)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Product images ─────────────────────────────────────
    // Vendor owners can upload images for products under their vendor
    match /product_images/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
                   && get(/databases/(default)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Driver license images ──────────────────────────────
    match /driver_licenses/{driverId}/{allPaths=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == driverId || isAdmin()
      );
      allow write: if isSignedIn() && request.auth.uid == driverId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
